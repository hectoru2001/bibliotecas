                <div class="submenu">
                    <a href="{% url 'coleccion_digital' %}">Colecci√≥n Digital DGB</a>
                    <a href="https://wordwall.net/es-mx/community/la-biblioteca">Juega y aprende</a>
                </div>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link">Servicios</a>
                    <div class="submenu">
                        <div class="dropdown">
                            <a href="#">Pr√©stamos</a>
                            <div class="dropdown-content">
                                <a href="{% url 'prestamos' %}">Pr√©stamo de libros en salas</a>
                                <a href="{% url 'prestamo_domicilio' %}">Pr√©stamo de libros a domicilio</a>
                            </div>
                        </div>
                        <a href="{% url 'credencializacion' %}">Credencializaci√≥n</a>
                        <a href="{% url 'referencia' %}">Referencia</a>
                        <a href="{% url 'servicio_digital' %}">Servicios Digitales</a>
                        <a href="{% url 'servicio_cultural' %}">Servicios Culturales</a>
                        <a href="{% url 'servicio_educativo' %}">Servicio educativo</a>
                    </div>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link">Nuestra Historia</a>
                <div class="submenu">
                </div>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link">Sobre nosotros</a>
