            <ul>
                <li><a href="#">Pr√©stamo de libros</a></li>
                <li><a href="#">Recursos digitales</a></li>
                <li><a href="#">Clubes de lectura</a></li>
                <li><a href="#">Talleres culturales</a></li>
                <li><a href="#">Sala de c√≥mputo</a></li>
            </ul>
        </div>
        <div class="footer-column">
