<!DOCTYPE html>
<html lang="es">
<head>
    {% load static %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <title>Pre-registro de Credencial - Bibliotecas P√∫blicas Municipales</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f5f5f5;
            color: #fff;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
            background-color: #DDDADB;
        }

        .logo img {
            height: 100px;
        }

        .main-nav {
            display: flex;
            align-items: center;
        }
        .right-section {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .right-logo {
            height: 120px; /* ajusta el tama√±o del logo derecho */
        }

        .nav-item {
            position: relative; /* Needed for positioning the submenu */
            margin: 0 20px; /* Spacing between nav items, adjust as needed */
        }

        .nav-link {
            color: #5C0432;
            text-decoration: none;
            font-size: 18px; /* Adjusted font size to match the image */
            padding: 10px 15px; /* Add padding for better spacing */
            display: block; /* Makes the entire area clickable */
        }

        .nav-link:hover {
            color: #ff6f61; /* Hover color */
        }

        /* Submenu styling */
        .submenu {
            display: none; /* Hidden by default */
            position: absolute;
            top: 100%; /* Position below the parent nav item */
            left: 0;
            background-color: #2e1212; /* Slightly lighter dark background for contrast */
            min-width: 150px; /* Minimum width for the submenu */
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2); /* Optional: adds a shadow for depth */
            z-index: 1000; /* Ensure it appears above other elements */
        }

        .submenu a {
            color: #ffffff;
            text-decoration: none;
            padding: 10px 15px;
            display: block; /* Makes the entire area clickable */
            font-size: 16px;
        }

        .submenu a:hover {
            background-color: #ff6f61; /* Hover effect for submenu items */
            color: #ffffff;
        }
        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            left: 100%; /* o right: 0; si quieres que se abra hacia el otro lado */
            top: 0;
            background-color: #2e1212; 
            min-width: 200px;
            z-index: 1;
            flex-direction: column;
            box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
        }

        .dropdown:hover .dropdown-content {
            display: flex;
        }

        /* Show submenu on hover */
        .nav-item:hover .submenu {
            display: block;
        }

        /* Style for the "Mi Cuenta" button */
        .account-btn {
            background-color: #922453;
            color: #ffffff;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 25px; /* Rounded corners */
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 5px; /* Space between icon and text */
        }

        .account-btn:hover {
            background-color: #e65a50; /* Slightly darker on hover */
        }
        
        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        h2 {
            color: #6b1c2f; /* Maroon color from the header */
            text-align: center;
            margin-bottom: 20px;
        }
        p, li {
            color: #333;
            line-height: 1.6;
            font-size: 16px;
        }
        ul {
            list-style-type: disc;
            margin-left: 20px;
        }
        .highlight {
            background-color: #f78787; /* Light yellow background to match the theme */
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        .button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #2a1321;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
            text-align: center;
            margin-top: 20px;
            transition: background-color 0.3s;
        }
        .button:hover {
            background-color: #8b2c4f;
        }
        .section-title {
            font-weight: bold;
            margin-top: 15px;
        }
        /* Footer */
        footer {
            background-color: #2a1321;
            padding: 40px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-top: 1px solid #3a1c2e;
        }

        .footer-column {
            width: 22%;
        }

        .footer-column img {
            height: 60px;
            margin-bottom: 10px;
        }

        .footer-column h3 {
            font-size: 16px;
            color: #fff;
            margin-bottom: 15px;
        }

        .footer-column p, .footer-column a {
            font-size: 14px;
            color: #d3b7c3;
            line-height: 1.6;
            text-decoration: none;
        }

        .footer-column a:hover {
            color: #ff6f61;
            text-decoration: underline;
        }

        .footer-column ul {
            list-style: none;
        }

        .footer-column ul li {
            margin-bottom: 10px;
        }

        .footer-column .social-icons {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }

        .footer-column .social-icons a {
            font-size: 25px;
            color: #922453;
        }

        .footer-column .social-icons a:hover {
            color: #ff6f61;
        }

        .footer-bottom {
            text-align: center;
            padding: 20px;
            background-color: #2a1321;
            border-top: 1px solid #3a1c2e;
            font-size: 12px;
            color: #d3b7c3;
        }

        @media (max-width: 768px) {
            .library-events {
                flex-direction: column;
            }

            .whats-happening {
                margin-right: 0;
                margin-bottom: 20px;
            }

            .category-nav {
                flex-wrap: wrap;
                justify-content: center;
            }

            .category-nav h2 {
                margin-bottom: 10px;
            }

            .carousel-items {
                width: 100%;
            }

            .media-item img {
                width: 120px;
                height: 180px;
            }

            footer {
                flex-direction: column;
                text-align: center;
            }

            .footer-column {
                margin-bottom: 20px;
            }

            .social-icons {
                margin-top: 10px;
            }
        }
    </style>
</head>
<body>
<!-- Header -->
    <header>
        <div class="logo">
