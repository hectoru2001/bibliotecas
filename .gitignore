# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales (Virtual Environments)
# Es vital no subir la carpeta del entorno para que el proyecto sea portable
venv/

# Django Media y Static
# Los archivos que suben los usuarios (media) no deben ir al repo
/static/
/media/
/staticfiles/

# Logs del sistema y de Django
*.log
local_settings.py

.env